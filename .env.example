# Copy this file to `.env` and fill in the values. `.env` is ignored by git.
# Never commit a real key, and never paste one into a chat or an issue.

# Model service key. Get one from the Anthropic console.
ANTHROPIC_API_KEY=

# Model used to draft practice problems. Matches the default in app/config.py.
ANTHROPIC_MODEL=claude-sonnet-5-5

# How hard the model thinks: low | medium | high | xhigh | max.
# "medium" is fastest and cheapest; raise it only if drafts are poor.
ANTHROPIC_EFFORT=medium

# Where drafts come from:
#   live   = call the model (needs the key and internet)
#   replay = play back a saved run from disk (no key, no internet)
# If the venue wifi fails, switch to replay.
ECHO_MODE=live
